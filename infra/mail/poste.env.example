# SMTP settings for Back VPS (Machine 2) after Poste.io is deployed
# Copy these into infra/docker/.env on Back server

SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=CHANGE_ME_mailbox_password_from_poste_admin
SMTP_FROM=noreply@yourdomain.com

# Deploy guide: docs/deploy-machine-4-mail.md

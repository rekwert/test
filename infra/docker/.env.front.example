# Machine 1 (Front VPS) - copy to infra/docker/.env

DOMAIN=cloud-hustle.com
API_DOMAIN=api.cloud-hustle.com
ACME_EMAIL=admin@cloud-hustle.com

# Back VPS gateway (Machine 2) — Selectel private network 192.168.0.0/24
# Front 192.168.0.3 -> Back 192.168.0.2 (public: 213.148.3.172 / 198.13.189.75)
BACK_VPS_IP=192.168.0.2
BACK_GATEWAY_URL=http://192.168.0.2:8080
# After setup-internal-gateway-tls.sh on back:
# BACK_GATEWAY_URL=https://192.168.0.2:8443

# Baked into web image at build time
NEXT_PUBLIC_API_URL=https://cloud-hustle.com/api/v1

IMAGE_TAG=latest

# Must match JWT_SECRET on the back server (signs vps_staff cookie).
STAFF_COOKIE_HMAC_KEY=

# Create at https://oauth.yandex.ru/ (scope metrika:read)
YANDEX_METRIKA_OAUTH_TOKEN=

# UFW: allow 80, 443 from anywhere; allow SSH

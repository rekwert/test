# OpenStack hypervisor (dev sandbox — do not commit secrets)

HYPERVISOR_PROVIDER=openstack

# Mock mode (local without OpenStack)
OPENSTACK_USE_MOCK=false

# Keystone
OPENSTACK_AUTH_URL=http://127.0.0.1:5000/v3
OPENSTACK_REGION=RegionOne
OPENSTACK_USERNAME=admin
OPENSTACK_PASSWORD=CHANGE_ME
OPENSTACK_PROJECT_NAME=admin
OPENSTACK_DOMAIN_NAME=Default

OPENSTACK_INSECURE_TLS=true

# Neutron
OPENSTACK_NETWORK_ID=
OPENSTACK_FLOATING_NETWORK_ID=
OPENSTACK_AVAILABILITY_ZONE=

# Catalog plan UUID -> Nova flavor
OPENSTACK_PLAN_MAP=

# Catalog os_template_id -> Glance image
OPENSTACK_OS_MAP=

OPENSTACK_PROVISION_REGIONS=nl,fi,de,gb

# Portal node UUID -> Nova compute hostname (scheduler hint)
# OPENSTACK_NODE_MAP=11111111-1111-1111-1111-111111111001:compute-nl-01

# Nova hypervisor UUID -> compute hostname (when nodes.external_id stores UUID)
# OPENSTACK_HV_MAP=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee:compute-nl-01

# Hypervisor SSH for SMTP block (optional)
# HV_SSH_USER=root
# HV_SSH_PASSWORD=
# HV_SSH_PRIVATE_KEY=

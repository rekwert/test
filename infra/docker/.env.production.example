# DEPRECATED — use infra/docker/.env.back.example as the canonical Back production template.
# This file is kept only so old docs/links do not break.

# Copy infra/docker/.env.back.example to infra/docker/.env on the Back VPS.
# Key production defaults (see .env.back.example for full list):
#   APP_ENV=production
#   POSTGRES_DSN=...?sslmode=require  (or POSTGRES_SSL_ALLOW_INSECURE=true during TLS migration)
#   VIRTFUSION_INSECURE_TLS=false
#   BILLING_MOCK=false
#   BACK_GATEWAY_PUBLIC_OK=true  (after infra/scripts/harden-back-ufw.sh)
#   IMAGE_TAG=<git short SHA of deployed commit>

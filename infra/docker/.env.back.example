# Machine 2 (Back VPS) - copy to infra/docker/.env

# --- Machine 3 DB (Selectel private 192.168.0.5 / public 108.174.78.39) ---
DB_VPS_IP=192.168.0.5
POSTGRES_USER=vps
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vps_platform
POSTGRES_DSN=postgres://vps:CHANGE_ME@192.168.0.5:6432/vps_platform?sslmode=require
# Direct Postgres for migrations (port 5432, not PgBouncer):
MIGRATION_DSN=postgres://vps:CHANGE_ME@192.168.0.5:5432/vps_platform?sslmode=require
# During DB TLS migration only: POSTGRES_SSL_ALLOW_INSECURE=true (with sslmode=disable)
POSTGRES_SSL_ALLOW_INSECURE=false
REDIS_URL=redis://:CHANGE_ME@10.0.0.3:6379/0

# --- Gateway (Front VPS proxies here via Selectel private 192.168.0.0/24) ---
# backVPS private 192.168.0.2 / public 198.13.189.75
# frontVPS private 192.168.0.3 / public 213.148.3.172
# Run infra/scripts/harden-back-ufw.sh then set BACK_GATEWAY_PUBLIC_OK=true if binding 0.0.0.0
BACK_BIND_IP=192.168.0.2
BACK_GATEWAY_PUBLIC_OK=false
GATEWAY_PORT=8080
GATEWAY_TLS_PORT=8443
GATEWAY_TLS_CERT=/certs/server.crt
GATEWAY_TLS_KEY=/certs/server.key
INTERNAL_GATEWAY_TLS_DIR=/opt/internal-gateway-tls
FRONT_VPS_IP=213.148.3.172
FRONT_PRIVATE_IP=192.168.0.3
# Trust Traefik on front (private + public) for per-client rate limits
TRUSTED_PROXY_IPS=192.168.0.3,213.148.3.172
JWT_SECRET=CHANGE_ME_LONG_RANDOM
# AES-256-GCM for root_password and ip_ssh_host_keys private keys (base64 32 bytes or raw 32 chars)
VPS_FIELD_ENCRYPTION_KEY=
# Ed25519 private key (OpenSSH PEM) for platform guest automation (IP change, etc.)
VPS_OPS_SSH_PRIVATE_KEY=
CORS_ORIGINS=https://cloud-hustle.com

# --- Mail (Selectel Email service) ---
# Selectel VPS blocks outbound 25/465/587 — use their SMTP relay:
#   STARTTLS: smtp.mail.selcloud.ru:1126  (SMTP_TLS=true,  SMTP_SSL=false)
#   Implicit: smtp.mail.selcloud.ru:1127  (SMTP_TLS=false, SMTP_SSL=true)
SMTP_HOST=smtp.mail.selcloud.ru
SMTP_PORT=1126
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@cloud-hustle.com

EMAIL_CODE_TTL=15m
PASSWORD_RESET_TTL=15m

# --- Billing / T-Bank acquiring ---
# Set BILLING_MOCK=false after deploy. Enable T-Bank when merchant is approved:
BILLING_MOCK=false
TBANK_ENABLED=false
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
# Test sandbox: https://rest-api-test.tinkoff.ru/v2
TBANK_NOTIFICATION_URL=https://cloud-hustle.com/api/v1/webhooks/payment
TBANK_SUCCESS_URL=https://cloud-hustle.com/vps/billing?payment=success
TBANK_FAIL_URL=https://cloud-hustle.com/vps/billing?payment=fail
# Fiscal receipt (required when online cash register is enabled on the terminal)
# Taxation: osn | usn_income | usn_income_outcome | patent | esn — must match your T-Business settings
TBANK_TAXATION=usn_income
TBANK_RECEIPT_TAX=none
TBANK_RECEIPT_ITEM_NAME=Пополнение баланса VPS

# --- Heleket crypto (optional) ---
HELEKET_ENABLED=false
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=
HELEKET_API_URL=https://api.heleket.com/v1
HELEKET_CALLBACK_URL=https://cloud-hustle.com/api/v1/webhooks/heleket
HELEKET_SUCCESS_URL=https://cloud-hustle.com/vps/billing?payment=success
HELEKET_RETURN_URL=https://cloud-hustle.com/vps/billing?payment=fail
HELEKET_CURRENCY=RUB

# --- Robokassa (international cards only) ---
# In Robokassa merchant cabinet enable ONLY foreign card acquiring.
# Result URL (webhook): https://cloud-hustle.com/api/v1/webhooks/robokassa
# Method: POST (or GET+POST)
#
# ERROR 23 "test payment cannot be created":
#   1) Robokassa LK → Магазины → cloud-hustle → Технические настройки
#   2) Fill block "Параметры проведения тестовых платежей" (test Password #1 and #2)
#   3) Put those test passwords into ROBOKASSA_TEST_PASSWORD1/2 below
#   OR set ROBOKASSA_TEST_MODE=false for real payments (use production Password #1/#2)
ROBOKASSA_ENABLED=false
ROBOKASSA_MERCHANT_LOGIN=cloud-hustle
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_TEST_MODE=true
ROBOKASSA_SUCCESS_URL=https://cloud-hustle.com/vps/billing?payment=success
ROBOKASSA_FAIL_URL=https://cloud-hustle.com/vps/billing?payment=fail

# --- OpenStack NL control (private IP of control BM) ---
# Worker on back VPS talks to Keystone/Nova here. VF vars below kept for rollback until cutover.
OPENSTACK_USE_MOCK=false
OPENSTACK_AUTH_URL=https://CHANGE_ME_CONTROL_PRIVATE_IP:5000/v3
OPENSTACK_REGION=RegionOne
OPENSTACK_USERNAME=admin
OPENSTACK_PASSWORD=CHANGE_ME
OPENSTACK_PROJECT_NAME=admin
OPENSTACK_DOMAIN_NAME=Default
OPENSTACK_INSECURE_TLS=true
OPENSTACK_NETWORK_ID=
OPENSTACK_FLOATING_NETWORK_ID=
OPENSTACK_AVAILABILITY_ZONE=
# Catalog plan UUID -> Nova flavor name (create flavors on control first)
OPENSTACK_PLAN_MAP=11111111-1111-1111-1111-111111111101:m1.small
OPENSTACK_OS_MAP=ubuntu-22.04:ubuntu-22.04,debian-12:debian-12
OPENSTACK_PROVISION_REGIONS=nl
# Nova hypervisor UUID -> hostname (from: openstack hypervisor list)
# OPENSTACK_HV_MAP=uuid:compute-nl-01,uuid2:compute-nl-02
# Portal node UUID -> hostname (optional pinning)
# OPENSTACK_NODE_MAP=

# --- VirtFusion (legacy — remove after OpenStack cutover) ---
VIRTFUSION_API_URL=https://66.248.206.14/api/v1
VIRTFUSION_API_KEY=CHANGE_ME
VIRTFUSION_USE_MOCK=false
# Map catalog plan UUID → VirtFusion package id (comma-separated).
VIRTFUSION_PLAN_MAP=11111111-1111-1111-1111-111111111101:1,11111111-1111-1111-1111-111111111102:2,11111111-1111-1111-1111-111111111103:3,11111111-1111-1111-1111-111111111104:4,11111111-1111-1111-1111-111111111105:9,11111111-1111-1111-1111-111111111106:10,11111111-1111-1111-1111-111111111107:11,11111111-1111-1111-1111-111111111108:12,11111111-1111-1111-1111-111111111501:1,11111111-1111-1111-1111-111111111502:2,11111111-1111-1111-1111-111111111503:3,11111111-1111-1111-1111-111111111504:4,11111111-1111-1111-1111-111111111505:9,11111111-1111-1111-1111-111111111506:10,11111111-1111-1111-1111-111111111507:11,11111111-1111-1111-1111-111111111508:12,11111111-1111-1111-1111-111111111211:17,11111111-1111-1111-1111-111111111212:18,11111111-1111-1111-1111-111111111213:19,11111111-1111-1111-1111-111111111214:20,11111111-1111-1111-1111-111111111215:21,11111111-1111-1111-1111-111111111216:10,11111111-1111-1111-1111-111111111217:11,11111111-1111-1111-1111-111111111221:5,11111111-1111-1111-1111-111111111222:6,11111111-1111-1111-1111-111111111223:7,11111111-1111-1111-1111-111111111224:8,11111111-1111-1111-1111-111111111225:13,11111111-1111-1111-1111-111111111226:14,11111111-1111-1111-1111-111111111227:15,11111111-1111-1111-1111-111111111511:17,11111111-1111-1111-1111-111111111512:18,11111111-1111-1111-1111-111111111513:19,11111111-1111-1111-1111-111111111514:20,11111111-1111-1111-1111-111111111515:21,11111111-1111-1111-1111-111111111516:10,11111111-1111-1111-1111-111111111517:11,11111111-1111-1111-1111-111111111521:5,11111111-1111-1111-1111-111111111522:6,11111111-1111-1111-1111-111111111523:7,11111111-1111-1111-1111-111111111524:8,11111111-1111-1111-1111-111111111525:13,11111111-1111-1111-1111-111111111526:14,11111111-1111-1111-1111-111111111527:15,11111111-1111-1111-1111-111111111601:1,11111111-1111-1111-1111-111111111602:1,11111111-1111-1111-1111-111111111603:1,11111111-1111-1111-1111-111111111604:1,11111111-1111-1111-1111-111111111701:1,11111111-1111-1111-1111-111111111702:2,11111111-1111-1111-1111-111111111703:3,11111111-1111-1111-1111-111111111704:4,11111111-1111-1111-1111-111111111705:9,11111111-1111-1111-1111-111111111706:10,11111111-1111-1111-1111-111111111707:11,11111111-1111-1111-1111-111111111708:12,11111111-1111-1111-1111-111111111711:17,11111111-1111-1111-1111-111111111712:18,11111111-1111-1111-1111-111111111713:19,11111111-1111-1111-1111-111111111714:20,11111111-1111-1111-1111-111111111715:21,11111111-1111-1111-1111-111111111716:10,11111111-1111-1111-1111-111111111717:11,11111111-1111-1111-1111-111111111721:5,11111111-1111-1111-1111-111111111722:6,11111111-1111-1111-1111-111111111723:7,11111111-1111-1111-1111-111111111724:8,11111111-1111-1111-1111-111111111725:13,11111111-1111-1111-1111-111111111726:14,11111111-1111-1111-1111-111111111727:15,11111111-1111-1111-1111-111111111801:1,11111111-1111-1111-1111-111111111802:2,11111111-1111-1111-1111-111111111803:3,11111111-1111-1111-1111-111111111804:4,11111111-1111-1111-1111-111111111805:9,11111111-1111-1111-1111-111111111806:10,11111111-1111-1111-1111-111111111807:11,11111111-1111-1111-1111-111111111808:12,11111111-1111-1111-1111-111111111811:17,11111111-1111-1111-1111-111111111812:18,11111111-1111-1111-1111-111111111813:19,11111111-1111-1111-1111-111111111814:20,11111111-1111-1111-1111-111111111815:21,11111111-1111-1111-1111-111111111816:10,11111111-1111-1111-1111-111111111817:11,11111111-1111-1111-1111-111111111821:5,11111111-1111-1111-1111-111111111822:6,11111111-1111-1111-1111-111111111823:7,11111111-1111-1111-1111-111111111824:8,11111111-1111-1111-1111-111111111825:13,11111111-1111-1111-1111-111111111826:14,11111111-1111-1111-1111-111111111827:15,11111111-1111-1111-1111-111111111901:16,11111111-1111-1111-1111-111111111911:16,11111111-1111-1111-1111-111111111921:16,11111111-1111-1111-1111-111111111931:16
VIRTFUSION_PACKAGE_ID=1
VIRTFUSION_HYPERVISOR_GROUP_ID=1
VIRTFUSION_DEFAULT_USER_ID=1
# Optional fallback if worker OS sync is disabled. Worker auto-syncs from VirtFusion API (recommended).
VIRTFUSION_OS_MAP=
VIRTFUSION_PROVISION_REGIONS=nl,fi
# Browser latency probes (code=https://url). Use HTTPS endpoints with valid TLS only.
# Deploy: infra/scripts/deploy-region-latency-probes.sh (needs DNS A records for probe-*).
REGION_PROBE_URLS=nl=https://panel.cloud-hustle.com/latency-probe,de=https://probe-de.cloud-hustle.com/,fi=https://probe-fi.cloud-hustle.com/,gb=https://probe-gb.cloud-hustle.com/
# TCP port for backbone_ms in /catalog/regions (VirtFusion API on hypervisors).
REGION_BACKBONE_PROBE_PORT=8892
VIRTFUSION_INSECURE_TLS=false
# SSH to VirtFusion control panel — required for change-IP ebtables sync (vfcli-ctrl server:configurations).
VIRTFUSION_CTRL_SSH_HOST=66.248.206.14
VIRTFUSION_CTRL_SSH_USER=root
VIRTFUSION_CTRL_SSH_PASSWORD=
# Optional instead of password:
# VIRTFUSION_CTRL_SSH_PRIVATE_KEY=
# Optional bastion for HV reachable only via VF panel SSH key (e.g. DE-mid 212.102.227.7).
# VIRTFUSION_HV_SSH_JUMP_HOST=66.248.206.14
# Per-hypervisor root passwords for SMTP allow/deny (admin buttons). Sync: infra/scripts/sync-hv-ssh-env.sh
# NL_SSH_PASS=
# DE_SSH_PASS=
# DE_MID_SSH_PASS=
# FI_SSH_PASS=
# GB_SSH_PASS=
VPS_NODE_SYNC_INTERVAL=2m
# Worker poll interval and provision timing (lower warmup = faster ready if guest-agent stable)
VPS_WORKER_INTERVAL=5s
VPS_GUEST_AGENT_WARMUP=45s
VPS_VF_RESET_MIN_GAP=30s

# --- Hetzner Robot (dedicated / Server Market) ---
# When HETZNER_ROBOT_ENABLED=false (or creds empty), worker uses mock lots for UI/dev.
HETZNER_ROBOT_ENABLED=false
HETZNER_ROBOT_USER=
HETZNER_ROBOT_PASSWORD=
HETZNER_ROBOT_API_URL=https://robot-ws.your-server.de
HETZNER_MARKUP_PERCENT=10
# IP block check from Russia (optional). If set, Back runs probe via SSH on this host.
# RU_IP_PROBE_SSH=root@YOUR_RU_PROBE_HOST
# RU_IP_PROBE_SCRIPT=/opt/testVPStrade/infra/scripts/ru-ip-probe.py
# Or HTTP probe service in Russia:
# RU_IP_PROBE_URL=https://probe.example.com/probe
# RU_IP_PROBE_TOKEN=
HETZNER_FX_SOURCE=cbr
HETZNER_FX_CBR_URL=https://www.cbr-xml-daily.ru/daily_json.js
HETZNER_FX_CACHE_TTL=1h
HETZNER_FX_SPREAD_PERCENT=0
HETZNER_EUR_RUB=100
HETZNER_PRICE_SLACK_PERCENT=5
HETZNER_SYNC_INTERVAL=2m
# Additional IPv4 on dedicated — fixed sell prices in RUB (defaults 250 / 500)
HETZNER_EXTRA_IPV4_MONTHLY_RUB=250
HETZNER_EXTRA_IPV4_SETUP_RUB=500
# Cost reference in EUR (unused for sell price when RUB vars set)
HETZNER_EXTRA_IPV4_EUR=1.70
HETZNER_EXTRA_IPV4_SETUP_EUR=4.90
HETZNER_EXTRA_IPV4_MAX=4

# VPS extra IPv4 (VirtFusion pool) — rent from LK, flat price per address
VPS_EXTRA_IPV4_RUB=250
VPS_EXTRA_IPV4_MAX=5

# --- Hostkey Invapi (dedicated bare-metal presets + stock) ---
# 1) Invapi https://invapi.hostkey.com → правый верх: email/имя → «API keys» (НЕ вкладка сервера «Конфигурация»)
# 2) «Добавить новый» → «Ограничить для сервера» = «Любой» (Any) → Создать → скопировать ключ (показывается 1 раз!)
# 3) Ссылка «панель управления сервером» внизу — это embed-виджет, не ограничение ключа
# Docs: https://hostkey.ru/documentation/account/api_key_account/
HOSTKEY_ENABLED=false
HOSTKEY_API_TOKEN=
# RU billing (panel.hostkey.ru) → https://invapi.hostkey.ru ; COM/US → https://invapi.hostkey.com
HOSTKEY_INVAPI_URL=https://invapi.hostkey.ru
HOSTKEY_MARKUP_PERCENT=10
# Native RUB from Invapi (monthly_ru) + markup. EUR fallback only if RUB missing:
HOSTKEY_EUR_RUB=
HOSTKEY_PRICE_SLACK_PERCENT=5
HOSTKEY_SYNC_INTERVAL=5m
HOSTKEY_EXTRA_IPV4_MAX=4

# --- Docker images (GHCR) ---
IMAGE_TAG=latest

# --- Firewall hint: allow port 8080 from FRONT_VPS_IP only (see harden-back-ufw.sh) ---

# --- Dunning (billing worker) ---
DUNNING_GRACE_HOURS=12
DUNNING_DELETE_DAYS=3
BILLING_DUNNING_INTERVAL=15m
BILLING_CHARGE_INTERVAL=15m

# --- Service-to-service notifications (billing → notification) ---
NOTIFICATION_SERVICE_URL=http://notification:8004
NOTIFICATION_SERVICE_TOKEN=CHANGE_ME_INTERNAL_TOKEN
SITE_URL=https://cloud-hustle.com

# --- Automated abuse detection (vps-worker scans + auto-stop) ---
ABUSE_ENABLED=true
ABUSE_SCAN_INTERVAL=2m
ABUSE_AUTO_STOP_THRESHOLD=100
ABUSE_TX_MBPS_THRESHOLD=150
ABUSE_TX_SUSTAINED_POLLS=4
ABUSE_SMTP_PROBE_INTERVAL=10m
ABUSE_MIN_DISTINCT_SIGNALS=2
ABUSE_NEW_INSTANCE_GRACE_BONUS=40
ABUSE_SIGNAL_WINDOW=1h
ABUSE_SIGNAL_DEDUPE=15m
# Generate: openssl rand -hex 32
# Used by mail ingest / external webhooks: POST http://vps:8003/internal/abuse/signal
# Header: X-Service-Token: <this value>  Body: {"ip":"...","signal_type":"provider_complaint"}
# Falls back to NOTIFICATION_SERVICE_TOKEN if empty.
ABUSE_INGEST_TOKEN=

# --- First-200 registrations promo (ops Telegram alert on signup) ---
REGISTRATION_PROMO_LIMIT=200
REGISTRATION_PROMO_BONUS_RUB=500
# Count users created on/after this date (YYYY-MM-DD or RFC3339). Adjust if N/200 is off.
REGISTRATION_PROMO_STARTED_AT=2026-08-02
# Domains blocked for NEW registration only (existing users can still log in). "-" disables.
BLOCKED_EMAIL_DOMAINS=proton.me,protonmail.com,protonmail.ch,pm.me

# --- Telegram bot (Machine 2 Back) ---
# Create bot via @BotFather, paste token. Leave empty to skip starting useful bot.
# Also passed to notification service for push on VPS/dedicated ready (inbox+email already work).
TELEGRAM_BOT_TOKEN=
# Ops/alerts channel — same values as cloud-hustle-monitoring/.env
# (TELEGRAM_BOT_TOKEN there → TELEGRAM_ALERTS_BOT_TOKEN here; TELEGRAM_CHAT_ID → TELEGRAM_ALERTS_CHAT_ID)
TELEGRAM_ALERTS_BOT_TOKEN=
TELEGRAM_ALERTS_CHAT_ID=
# Alias accepted by notification service if ALERTS_* empty:
# TELEGRAM_CHAT_ID=
# Public bot username without @ (for t.me deep-links from settings)
TELEGRAM_BOT_USERNAME=
# Same secret as NOTIFICATION_SERVICE_TOKEN (auth ↔ bot)
TELEGRAM_INTERNAL_TOKEN=CHANGE_ME_INTERNAL_TOKEN
SITE_URL=https://cloud-hustle.com
TELEGRAM_CHANNEL_URL=https://t.me/+HbSdIOauph9hMjAy
TELEGRAM_SUPPORT_URL=https://cloud-hustle.com/vps/support

# --- Gateway rate limiting (Redis) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_AUTH=120
RATE_LIMIT_SENSITIVE=15
RATE_LIMIT_SENSITIVE_WINDOW=1m

# --- Notification worker ---
NOTIFICATION_WORKER_INTERVAL=5s

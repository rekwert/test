# Local dev — copy to .env.local and run: .\infra\scripts\local-dev-up.ps1

POSTGRES_USER=vps
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vps_platform
JWT_SECRET=dev-local-jwt-secret-change-me
VPS_FIELD_ENCRYPTION_KEY=01234567890123456789012345678901
NOTIFICATION_SERVICE_TOKEN=dev-internal-token

# Billing without real payments
BILLING_MOCK=true

# Tier 1: mock OpenStack (no cloud needed)
OPENSTACK_USE_MOCK=true
HYPERVISOR_PROVIDER=openstack
OPENSTACK_PROVISION_REGIONS=nl,fi,de,gb
OPENSTACK_PLAN_MAP=11111111-1111-1111-1111-111111111101:m1.small
OPENSTACK_OS_MAP=ubuntu-22.04:ubuntu-22.04,debian-12:debian-12

# Tier 2: real OpenStack in WSL (after infra/openstack/wsl-sunbeam-install.sh)
# OPENSTACK_USE_MOCK=false
# OPENSTACK_AUTH_URL=http://host.docker.internal:5000/v3
# OPENSTACK_USERNAME=admin
# OPENSTACK_PASSWORD=...
# OPENSTACK_PROJECT_NAME=admin
# OPENSTACK_DOMAIN_NAME=Default
# OPENSTACK_INSECURE_TLS=true
# OPENSTACK_NETWORK_ID=...
# OPENSTACK_FLOATING_NETWORK_ID=...

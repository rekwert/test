# Machine 4 (Mail VPS) - copy to infra/docker/.env

# FQDN for mail server (must match DNS A record and PTR)
POSTE_HOSTNAME=mail.yourdomain.com

TZ=Europe/Moscow

# Optional: save RAM on small VPS (4 GB)
DISABLE_CLAMAV=1

# For deploy script hints / firewall
BACK_VPS_IP=10.0.0.2
ADMIN_IP=YOUR_HOME_IP

# SMTP mailbox created in Poste admin (for Back VPS .env)
SMTP_USER=noreply@yourdomain.com
SMTP_FROM=noreply@yourdomain.com

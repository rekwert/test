# Machine 3 (DB VPS) - copy to .env on the database server

POSTGRES_USER=vps
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=vps_platform

REDIS_PASSWORD=CHANGE_ME_STRONG

# Bind Postgres/Redis/PgBouncer on host. Prefer private IP; use 0.0.0.0 only with UFW (Back VPS only).
DB_BIND_IP=0.0.0.0

# Back VPS private IP — used by harden-db-ufw.sh (Selectel 192.168.0.0/24)
BACK_VPS_IP=192.168.0.2
# Back VPS public IP — if Back connects via public address (current prod uses this)
BACK_VPS_PUBLIC_IP=198.13.189.75

# TLS certs for Postgres (run infra/scripts/setup-postgres-ssl.sh on DB host)
POSTGRES_SSL_DIR=/opt/postgres-ssl

# PgBouncer pool (services should use port 6432 via POSTGRES_DSN on Back VPS)
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
